generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id             String          @id @default(uuid())
  cnpj           String          @unique
  razaoSocial    String
  monitoramentos Monitoramento[]
}

model Monitoramento {
  id                String  @id @default(uuid())
  empresaId         String
  empresa           Empresa @relation(fields: [empresaId], references: [id])
  segmentoCodigo    String
  segmentoDescricao String
  uf                String
  municipio         String?
  ativo             Boolean @default(true)

  @@unique([empresaId, segmentoCodigo, uf, municipio])
}

model Edital {
  id                        String   @id @default(uuid())
  editalId                  String
  versao                    Int
  numeroDeProcesso          String
  nomeDoOrgao               String
  esfera                    String
  uf                        String
  municipio                 String?
  objeto                    String
  valorEstimadoEmCentavos   Int
  dataDePublicacao          DateTime
  dataDeEntregaDaProposta   DateTime
  segmentoInferidoCodigo    String?
  segmentoInferidoDescricao String?
  classificacaoDoItemCodigo    String?
  classificacaoDoItemDescricao String?

  @@unique([editalId, versao])
}
