generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id                  String               @id @default(uuid())
  cnpj                String               @unique
  razaoSocial         String
  monitoramentos      Monitoramento[]
  dossieDeHabilitacao DossieDeHabilitacao?
  alertas             Alerta[]
}

model Monitoramento {
  id                String  @id @default(uuid())
  empresaId         String
  empresa           Empresa @relation(fields: [empresaId], references: [id])
  segmentoCodigo    String
  segmentoDescricao String
  uf                String
  municipio         String?
  ativo             Boolean @default(true)

  @@unique([empresaId, segmentoCodigo, uf, municipio])
}

model Edital {
  id                        String   @id @default(uuid())
  editalId                  String
  versao                    Int
  numeroDeProcesso          String
  nomeDoOrgao               String
  esfera                    String
  uf                        String
  municipio                 String?
  objeto                    String
  valorEstimadoEmCentavos   Int
  dataDePublicacao          DateTime
  dataDeEntregaDaProposta   DateTime
  segmentoInferidoCodigo    String?
  segmentoInferidoDescricao String?
  classificacaoDoItemCodigo    String?
  classificacaoDoItemDescricao String?

  @@unique([editalId, versao])
}

model DossieDeHabilitacao {
  id        String     @id @default(uuid())
  empresaId String     @unique
  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  certidoes Certidao[]
}

model Certidao {
  id                    String              @id @default(uuid())
  dossieDeHabilitacaoId String
  dossieDeHabilitacao   DossieDeHabilitacao @relation(fields: [dossieDeHabilitacaoId], references: [id])
  tipo                  String
  dataDeEmissao         DateTime
  dataDeValidade        DateTime
  arquivoCaminho        String
  arquivoNomeOriginal   String
  arquivoEnviadoEm      DateTime
}

model Alerta {
  id             String    @id @default(uuid())
  empresaId      String
  empresa        Empresa   @relation(fields: [empresaId], references: [id])
  tipo           String
  origemTipo     String
  origemId       String
  canal          String
  status         String
  momentoDeEnvio DateTime?

  @@index([empresaId, tipo, origemTipo, origemId])
}
