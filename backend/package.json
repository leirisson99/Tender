{
  "name": "tender-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Agente que monitora editais de licitação e a validade da documentação de habilitação da empresa.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "keywords": [],
  "dependencies": {
    "@prisma/client": "7.10.0",
    "fastify": "^5.12.4",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "prisma": "7.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true,
    "prisma@7.10.0": true
  }
}
